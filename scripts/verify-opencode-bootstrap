#!/usr/bin/env python3
"""Normal-host disposable discovery for OpenCode offline bootstrap behavior."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile

from tori.coding_work_bootstrap import OpenCodeOfflineBootstrapper


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--opencode", type=Path, required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--network-authorized", action="store_true")
    arguments = parser.parse_args()
    if os.environ.get("TORI_RUN_OPENCODE_BOOTSTRAP_DISCOVERY") != "1":
        parser.error("set TORI_RUN_OPENCODE_BOOTSTRAP_DISCOVERY=1 explicitly")
    if not arguments.network_authorized:
        parser.error("network observation requires the separately authorized --network-authorized flag")
    tracer = shutil.which("strace")
    if tracer is None:
        parser.error("strace is unavailable; network behavior cannot be observed safely")
    with tempfile.TemporaryDirectory(prefix="tori-opencode-bootstrap-discovery-") as temporary:
        root = Path(temporary)
        destination = root / "opencode/bootstrap-cache"
        destination.mkdir(parents=True, mode=0o700)
        os.chmod(destination.parent, 0o700)
        os.chmod(destination, 0o700)
        trace = root / "network.trace"

        def traced_runner(command, cwd, environment):  # type: ignore[no-untyped-def]
            return subprocess.run(
                (
                    tracer, "-f", "-e", "trace=network,file", "-s", "256",
                    "-o", str(trace), "--", *command,
                ),
                cwd=cwd, env=dict(environment), stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                timeout=120, check=False, umask=0o077,
            )

        result = OpenCodeOfflineBootstrapper(
            destination=destination,
            opencode_executable=arguments.opencode,
            opencode_version="1.18.31",
            model=arguments.model,
            runner=traced_runner,
        ).prepare()
        print(f"cache_file_count={result.cache_file_count}")
        print(f"cache_total_bytes={result.cache_total_bytes}")
        print(f"cache_digest={result.cache_digest}")
        print("prepared_inventory:")
        entries = sorted(result.prepared_root.rglob("*"))
        for path in entries[:500]:
            metadata = path.lstat()
            kind = "directory" if stat.S_ISDIR(metadata.st_mode) else "file"
            print(
                f"  {path.relative_to(result.prepared_root).as_posix()}|{kind}|"
                f"{stat.S_IMODE(metadata.st_mode):04o}|{metadata.st_size}"
            )
        if len(entries) > 500:
            print(f"  ... {len(entries) - 500} additional entries omitted")
        print("network_and_file_trace:")
        lines = trace.read_text(encoding="utf-8", errors="replace").splitlines()
        for line in lines[:500]:
            print("  " + line[:1000])
        if len(lines) > 500:
            print(f"  ... {len(lines) - 500} additional trace lines omitted")
    return 0


if __name__ == "__main__":
    sys.exit(main())
