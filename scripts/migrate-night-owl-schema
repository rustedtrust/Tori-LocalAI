#!/usr/bin/env python3
"""Explicit Night Owl schema migration; normal application reads never migrate."""

from __future__ import annotations

import argparse
from pathlib import Path

from tori.night_owl import DEFAULT_STORE_PATH, SQLiteNightOwlStore


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--path", type=Path, default=DEFAULT_STORE_PATH)
    arguments = parser.parse_args()
    store = SQLiteNightOwlStore(arguments.path)
    # This command is intentionally the only production migration path.  It
    # performs one bounded, verified step at a time so operators never have to
    # infer which schema transition was applied.
    before, after = store.migrate_to_latest()
    print(f"Night Owl schema migrated: {before} -> {after}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
