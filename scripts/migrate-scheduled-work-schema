#!/usr/bin/env python3
"""Explicit Scheduled Work schema migration entry point."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from tori.scheduled_work_migration import (  # noqa: E402
    ScheduledWorkMigrationError,
    migrate_scheduled_work_schema,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Migrate one exact Tori Scheduled Work store from schema 1 to schema 2."
    )
    parser.add_argument("path", help="Exact existing store path; there is no default.")
    arguments = parser.parse_args()
    try:
        definitions, authorizations, runs, notifications = (
            migrate_scheduled_work_schema(arguments.path)
        )
    except ScheduledWorkMigrationError as exc:
        print(f"Migration refused: {exc}", file=sys.stderr)
        return 1
    print(
        "Scheduled Work migration verified: schema 1 -> 2; "
        f"definitions={definitions}; authorizations={authorizations}; "
        f"runs={runs}; notifications={notifications}."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
