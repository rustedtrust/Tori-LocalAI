#!/usr/bin/env python3
"""Opt-in temporary end-to-end acceptance for the production OpenCode adapter."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import shutil
import socket
import stat
import subprocess
import sys
from tempfile import TemporaryDirectory
import threading
import time
import urllib.request


REPOSITORY = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY / "src"))

from tori.coding_work import CodingWorkAuthority, SQLiteCodingWorkStore  # noqa: E402
from tori.coding_work_application import CodingWorkApplicationService  # noqa: E402
from tori.coding_work_opencode import (  # noqa: E402
    OpenCodeAdapterSettings,
    OpenCodeCodingWorkerAdapter,
    _configuration,
)
from tori.coding_work_provider_transport import (  # noqa: E402
    CHAT_COMPLETIONS_PATH,
    OpenAICompatibleInferencePolicy,
)
from tori.coding_work_supervisor import BubblewrapCodingWorkSandbox  # noqa: E402
from tori.coding_worker import FakeCodingWorkerAdapter  # noqa: E402


OPENCODE = Path.home() / ".opencode/bin/opencode"
MODEL = "qwen3.8:latest"
FLAG = "TORI_RUN_OPENCODE_ADAPTER_ACCEPTANCE"
MODEL_TURN_TIMEOUT_SECONDS = 15 * 60.0


class _HostService:
    def __init__(self) -> None:
        self.socket = socket.socket()
        self.socket.bind(("127.0.0.1", 0))
        self.socket.listen()
        self.socket.settimeout(0.2)
        self.port = int(self.socket.getsockname()[1])
        self.reached = False
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._serve, daemon=True)

    def _serve(self) -> None:
        while not self._stop.is_set():
            try:
                client, _address = self.socket.accept()
            except TimeoutError:
                continue
            except OSError:
                return
            self.reached = True
            client.close()

    def __enter__(self) -> "_HostService":
        self._thread.start()
        return self

    def __exit__(self, *_args: object) -> None:
        self._stop.set()
        self.socket.close()
        self._thread.join(timeout=2)


def _require_host_support() -> Path:
    if os.environ.get(FLAG) != "1":
        raise SystemExit(f"Set {FLAG}=1 to run this disposable normal-host acceptance.")
    bwrap = shutil.which("bwrap")
    if bwrap is None:
        raise SystemExit("Bubblewrap is unavailable.")
    if not OPENCODE.is_file():
        raise SystemExit(f"OpenCode is unavailable at {OPENCODE}.")
    probe_command = [
        bwrap, "--unshare-all", "--ro-bind", "/usr", "/usr",
        "--symlink", "usr/bin", "/bin", "--symlink", "usr/lib", "/lib",
        "--proc", "/proc", "--dev", "/dev", "--", "/usr/bin/true",
    ]
    if Path("/usr/lib64").exists():
        insertion = probe_command.index("--proc")
        probe_command[insertion:insertion] = ["--symlink", "usr/lib64", "/lib64"]
    probe = subprocess.run(
        probe_command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        timeout=5,
        check=False,
    )
    if probe.returncode != 0:
        raise SystemExit(
            "Bubblewrap namespaces are unavailable: "
            + probe.stderr.decode("utf-8", errors="replace")[:1_000]
        )
    with urllib.request.urlopen("http://127.0.0.1:11434/api/tags", timeout=3) as response:
        tags = json.load(response)
    if MODEL not in {item.get("name") for item in tags.get("models", [])}:
        raise SystemExit(f"The existing local model {MODEL} is unavailable; no download was attempted.")
    return Path(bwrap)


def _bootstrap_private_state(
    root: Path, work_id: str, workspace: Path, authority: CodingWorkAuthority
) -> None:
    config = root / "bootstrap-config/opencode"
    state = root / "works" / work_id / "state"
    config.mkdir(parents=True)
    for path in (state / "home", state / "data", state / "cache", state / "state"):
        path.mkdir(parents=True, exist_ok=True)
    config.joinpath("opencode.json").write_text(
        _configuration(authority, MODEL), encoding="utf-8"
    )
    environment = {
        "PATH": f"{OPENCODE.parent}:/usr/local/bin:/usr/bin:/bin",
        "HOME": str(state / "home"),
        "XDG_CONFIG_HOME": str(root / "bootstrap-config"),
        "XDG_DATA_HOME": str(state / "data"),
        "XDG_CACHE_HOME": str(state / "cache"),
        "XDG_STATE_HOME": str(state / "state"),
        "TMPDIR": str(state / "cache"),
        "OPENCODE_DISABLE_AUTOUPDATE": "true",
    }
    subprocess.run(
        (str(OPENCODE), "debug", "config", "--pure"),
        cwd=workspace,
        env=environment,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        timeout=30,
        check=True,
    )


def _wait_for_state(
    application: CodingWorkApplicationService,
    work_id: str,
    expected: set[str],
    *,
    timeout_seconds: float = MODEL_TURN_TIMEOUT_SECONDS,
    store: SQLiteCodingWorkStore | None = None,
    adapter: OpenCodeCodingWorkerAdapter | None = None,
):  # type: ignore[no-untyped-def]
    deadline = time.monotonic() + timeout_seconds
    latest = application.inspect(work_id)
    while latest.state not in expected:
        if latest.state in {"failed", "cancelled", "completed"}:
            diagnostics = ""
            if store is not None and adapter is not None and latest.current_run_id is not None:
                run = store.get_run(latest.current_run_id)
                try:
                    detail = adapter.diagnostics_for_launch(run.launch_correlation_id)
                except Exception as diagnostic_error:
                    diagnostics = f" diagnostics_error={diagnostic_error!r};"
                else:
                    diagnostics = (
                        f" exit={detail.exit_code!r}; stderr={detail.stderr[-4_000:]!r};"
                        f" termination={detail.termination!r};"
                    )
            raise RuntimeError(
                f"Coding Work reached unexpected state {latest.state}; "
                f"progress={latest.progress!r}; result={latest.result!r};{diagnostics}"
            )
        if time.monotonic() >= deadline:
            raise TimeoutError(
                f"Coding Work did not reach {sorted(expected)}; current state is {latest.state}."
            )
        time.sleep(0.25)
        latest = application.inspect(work_id)
    return latest


def _runtime_snapshot() -> tuple[tuple[str, str, str], ...]:
    root = REPOSITORY / "runtime"
    records: list[tuple[str, str, str]] = []
    for directory, names, files in os.walk(root, followlinks=False):
        relative_directory = Path(directory).relative_to(REPOSITORY).as_posix()
        records.append(("directory", relative_directory, ""))
        for name in sorted(names):
            path = Path(directory) / name
            metadata = path.lstat()
            if stat.S_ISLNK(metadata.st_mode):
                records.append(("symlink", path.relative_to(REPOSITORY).as_posix(), os.readlink(path)))
        for name in sorted(files):
            path = Path(directory) / name
            metadata = path.lstat()
            relative = path.relative_to(REPOSITORY).as_posix()
            if stat.S_ISREG(metadata.st_mode):
                records.append(("file", relative, _hash_file_no_follow(path)))
            elif stat.S_ISLNK(metadata.st_mode):
                records.append(("symlink", relative, os.readlink(path)))
            else:
                records.append(("other", relative, str(metadata.st_mode)))
    return tuple(sorted(set(records)))


def _hash_file_no_follow(path: Path) -> str:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        digest = hashlib.sha256()
        while True:
            chunk = os.read(descriptor, 64 * 1024)
            if not chunk:
                return digest.hexdigest()
            digest.update(chunk)
    finally:
        os.close(descriptor)


def _adapter(
    private: Path, bwrap: Path, host_port: int
) -> OpenCodeCodingWorkerAdapter:
    return OpenCodeCodingWorkerAdapter(
        OpenCodeAdapterSettings(
            OPENCODE,
            private,
            OpenAICompatibleInferencePolicy("127.0.0.1", 11434, MODEL),
            security_probe=True,
            probe_host_port=host_port,
        ),
        sandbox=BubblewrapCodingWorkSandbox(str(bwrap)),
    )


def _assert_filtered(store: SQLiteCodingWorkStore, work_id: str) -> tuple[str, ...]:
    events = store.events(work_id)
    encoded = json.dumps([event.payload for event in events], sort_keys=True).lower()
    for forbidden in (
        "agent_thought_chunk", "private reasoning", "usage_update",
        "available_commands_update", "token delta",
    ):
        if forbidden in encoded:
            raise RuntimeError(f"A prohibited OpenCode stream item was persisted: {forbidden}")
    return tuple(event.kind for event in events)


def main() -> int:
    runtime_before = _runtime_snapshot()
    bwrap = _require_host_support()
    prior_umask = os.umask(0o077)
    adapter: OpenCodeCodingWorkerAdapter | None = None
    try:
        with TemporaryDirectory(prefix="tori-opencode-adapter-acceptance-") as temporary:
            root = Path(temporary)
            workspace = root / "workspace"
            private = root / "opencode-private"
            workspace.mkdir()
            workspace.joinpath("synthetic.txt").write_bytes(b"before\n")
            subprocess.run(("git", "init", "-q", str(workspace)), check=True, timeout=10)
            subprocess.run(
                (
                    "git", "-C", str(workspace), "-c", "user.name=Tori Fixture",
                    "-c", "user.email=tori-fixture@example.invalid", "add", "synthetic.txt",
                ),
                check=True,
                timeout=10,
            )
            subprocess.run(
                (
                    "git", "-C", str(workspace), "-c", "user.name=Tori Fixture",
                    "-c", "user.email=tori-fixture@example.invalid", "commit", "-q",
                    "-m", "Synthetic fixture",
                ),
                check=True,
                timeout=10,
            )

            store = SQLiteCodingWorkStore(root / "coding-work/coding-work.db")
            store.initialize()
            application_without_worker = CodingWorkApplicationService(  # only creates authority
                store,
                FakeCodingWorkerAdapter(),
            )
            proposed = application_without_worker.create_work(
                objective=(
                    "Inspect this Git workspace and report its current branch and HEAD commit. "
                    "Do not modify anything."
                ),
                acceptance_criteria="Report the branch and HEAD without changing workspace files.",
                workspace_root=workspace,
            )
            authorized = application_without_worker.authorize(
                proposed.identifier,
                expected_revision=proposed.revision,
                read_allowed=True,
                modify_allowed=True,
                sandboxed_execution_allowed=True,
                confirmation_provenance="explicit_disposable_host_acceptance",
            )
            authority_record = store.get_authorization(authorized.current_authorization_id)
            authority = CodingWorkAuthority.from_document(authority_record.authority)
            _bootstrap_private_state(private, authorized.identifier, workspace, authority)

            with _HostService() as host_service:
                adapter = _adapter(private, bwrap, host_service.port)
                first_application = CodingWorkApplicationService(store, adapter)
                started = first_application.start(
                    authorized.identifier, expected_revision=authorized.revision
                )
                initial = _wait_for_state(
                    first_application,
                    started.identifier,
                    {"completed"},
                    store=store,
                    adapter=adapter,
                )
                run = store.get_run(initial.current_run_id)
                session_id = run.harness_session_id
                if session_id is None or not session_id.startswith("ses_"):
                    raise RuntimeError("The stable OpenCode session ID was not persisted.")
                if workspace.joinpath("synthetic.txt").read_bytes() != b"before\n":
                    raise RuntimeError("The read-only model turn changed the workspace fixture.")
                if initial.progress.get("changed_paths", []):
                    raise RuntimeError("Tori reported changes for the read-only model turn.")
                if adapter.has_live_writer():
                    raise RuntimeError("The completed bounded turn retained a live writer.")
                if os.path.lexists(private / "ipc/provider.sock"):
                    raise RuntimeError("The completed bounded turn retained provider IPC.")
                initial_audit = adapter.provider_audit

                event_kinds = _assert_filtered(store, initial.identifier)
                all_audit = initial_audit
                allowed = [item for item in all_audit if item.outcome == "allowed"]
                if not allowed or any(item.path != CHAT_COMPLETIONS_PATH for item in allowed):
                    raise RuntimeError("The provider relay admitted an unexpected operation.")
                if not any(item.outcome == "rejected:method_denied" for item in all_audit):
                    raise RuntimeError("The sandbox provider security probe was not observed.")
                if host_service.reached:
                    raise RuntimeError("The isolated worker reached an unrelated host service.")

                print(json.dumps({
                    "work_id": initial.identifier,
                    "run_id": run.identifier,
                    "session_id": session_id,
                    "workspace_bytes": "before\\n",
                    "changed_paths": initial.progress.get("changed_paths", []),
                    "final_state": initial.state,
                    "event_kinds": event_kinds,
                    "provider_requests": len(all_audit),
                    "allowed_provider_requests": len(allowed),
                    "security_probe_rejections": sum(
                        item.outcome.startswith("rejected:") for item in all_audit
                    ),
                }, sort_keys=True))
    finally:
        if adapter is not None:
            adapter.shutdown()
        os.umask(prior_umask)
        if _runtime_snapshot() != runtime_before:
            raise RuntimeError("Canonical runtime changed during disposable adapter acceptance.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
