#!/usr/bin/env python3
"""Explicitly migrate one exact Tori memory database from schema 2 to 3."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from tori.memory import MemoryError, SQLiteMemoryStore  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("database", type=Path)
    arguments = parser.parse_args()
    store = SQLiteMemoryStore(arguments.database)
    try:
        before, after = store.migrate_v2_to_v3()
    except MemoryError as exc:
        print(json.dumps({"ok": False, "error": type(exc).__name__}))
        return 1
    print(json.dumps({
        "ok": True,
        "database": str(arguments.database),
        "from_schema": 2,
        "to_schema": 3,
        "records_before": before,
        "records_after": after,
    }, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
