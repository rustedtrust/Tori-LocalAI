#!/usr/bin/env python3
"""Create an offline portable ZIP from an explicit, reviewed public file list."""

from __future__ import annotations

import os
from pathlib import Path, PurePosixPath
import stat
import sys
import zipfile


ROOT = Path(__file__).resolve().parents[1]
MANIFEST = "PUBLIC_SNAPSHOT_FILES.txt"
TEMPLATE = "deploy/portable/tori.toml"
IGNORED_ROOTS = frozenset({".git", ".venv", "runtime", "models", "artifacts", "backups", "build", "dist", "logs", "tmp", "node_modules", ".cache", ".pytest_cache"})
IGNORED_PARTS = frozenset({".venv", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache"})
FORBIDDEN_SUFFIXES = (".db", ".sqlite", ".sqlite3", ".log", ".pyc", "-wal", "-shm", "-journal")
ZIP_TIMESTAMP = (1980, 1, 1, 0, 0, 0)
REQUIRED_PUBLIC = frozenset({
    "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "SECURITY.md",
    "PUBLIC_SNAPSHOT_MANIFEST.md",
})
XTERM_LICENSES = frozenset({
    "src/tori/web_assets/vendor/xterm/LICENSE-xterm",
    "src/tori/web_assets/vendor/xterm/LICENSE-addon-fit",
})


def fail(message: str) -> None:
    raise ValueError(message)


def private_name(path: PurePosixPath) -> bool:
    parts = path.parts
    return (
        not parts or parts[0] in IGNORED_ROOTS
        or any(part in IGNORED_PARTS or part == ".git" or part == "secrets" or part == "credentials" for part in parts)
        or path.name == "tori.toml" and len(parts) == 1
        or path.name == ".env" or path.name.startswith(".env.")
        or path.name.endswith(FORBIDDEN_SUFFIXES)
    )


def files() -> list[str]:
    manifest = ROOT / MANIFEST
    if not manifest.is_file() or manifest.is_symlink():
        fail("the reviewed file manifest is unavailable")
    entries = manifest.read_text(encoding="utf-8").splitlines()
    if not entries or entries != sorted(set(entries)) or MANIFEST not in entries or TEMPLATE not in entries:
        fail("the reviewed file manifest is missing, unsorted, or duplicated")
    included = set(entries)
    if not REQUIRED_PUBLIC <= included:
        fail("public release license, notices, policy, or documentation is missing")
    if any(name.startswith("src/tori/web_assets/vendor/xterm/") for name in entries) and not XTERM_LICENSES <= included:
        fail("the bundled terminal assets require both upstream license files")
    if any(name in included for name in ("deploy/voice/recognizer.py", "deploy/voice/runtime.py")) and "deploy/voice/NOTICE.md" not in included:
        fail("the Voice integration requires its upstream provenance notice")
    for name in entries:
        path = PurePosixPath(name)
        if name != path.as_posix() or path.is_absolute() or any(p in {"", ".", ".."} for p in path.parts) or private_name(path):
            fail("an unsafe file was listed in the public manifest")
        file_path = ROOT
        for part in path.parts:
            file_path = file_path / part
            mode = os.lstat(file_path).st_mode
            if stat.S_ISLNK(mode):
                fail("a public source path is a symbolic link")
        if not stat.S_ISREG(os.lstat(file_path).st_mode):
            fail("a public manifest entry is not a regular file")

    # Unknown files in an included directory cannot silently enter the package.
    # Do not descend into private local state even when it is present on the host.
    observed: set[str] = set()
    for directory, children, filenames in os.walk(ROOT, followlinks=False):
        relative = Path(directory).relative_to(ROOT)
        children[:] = [name for name in children if not (
            (relative == Path(".") and name in IGNORED_ROOTS)
            or name in IGNORED_PARTS
        )]
        for name in filenames:
            relative_file = (relative / name).as_posix()
            if relative_file == "tori.toml" or name in {".DS_Store", "Thumbs.db"}:
                continue
            if private_name(PurePosixPath(relative_file)):
                fail("unexpected private/generated file in public source")
            observed.add(relative_file)
    if observed != set(entries):
        fail("public source does not match the explicit reviewed file manifest")
    return entries


def add_file(archive: zipfile.ZipFile, name: str, content: bytes, mode: int) -> None:
    info = zipfile.ZipInfo("Tori/" + name, ZIP_TIMESTAMP)
    info.create_system = 3
    info.external_attr = (stat.S_IFREG | mode) << 16
    info.compress_type = zipfile.ZIP_DEFLATED
    archive.writestr(info, content)


def create(output: Path) -> None:
    if not output.is_absolute() or ROOT == output or ROOT in output.parents or output.exists() or output.is_symlink():
        fail("provide a new absolute ZIP path outside the installation")
    if not output.parent.is_dir():
        fail("ZIP destination parent is missing")
    names = files()
    try:
        with zipfile.ZipFile(output, "x", compression=zipfile.ZIP_DEFLATED) as archive:
            for name in names:
                path = ROOT / name
                descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
                with os.fdopen(descriptor, "rb") as source:
                    info = os.fstat(source.fileno())
                    if not stat.S_ISREG(info.st_mode):
                        fail("unsafe public source file")
                    content = source.read()
                    if os.fstat(source.fileno()).st_size != len(content):
                        fail("public source changed while packaging")
                add_file(archive, name, content, stat.S_IMODE(info.st_mode) & 0o755)
            add_file(archive, "tori.toml", (ROOT / TEMPLATE).read_bytes(), 0o644)
    except BaseException:
        # Only this call's newly created output can be removed.
        if output.is_file() and not output.is_symlink():
            output.unlink()
        raise


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            fail("usage: scripts/create-clean-portable-archive /absolute/output.zip")
        create(Path(sys.argv[1]))
        print("Created reviewed public snapshot ZIP (no Git history or runtime).")
    except (OSError, ValueError, zipfile.BadZipFile) as exc:
        print(f"ERROR: public snapshot refused: {type(exc).__name__}", file=sys.stderr)
        raise SystemExit(1) from None
